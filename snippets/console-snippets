initDOMReferences();
console.table(Object.keys(window).filter((key) => key.includes("Btn") || key.includes("Modal")));

async function checkStandingsHealth() {
    const { collection, getDocs, query, where } = window.firebaseMethods;
    const exercise = window.currentExercise || "pushups";
    const standingsRef = collection(window.db, "standings");

    console.log(
        `%c 🛡️ Checking Standings for: ${exercise.toUpperCase()} `,
        "background: #111; color: #00ff00; font-weight: bold;",
    );

    try {
        const snap = await getDocs(query(standingsRef, where("exerciseId", "==", exercise)));

        if (snap.empty) {
            console.warn("⚠️ No standings found for this exercise. Have you synced yet?");
            return;
        }

        const report = snap.docs.map((doc) => {
            const d = doc.data();
            return {
                "Doc ID": doc.id,
                Type: d.type,
                Period: d.periodId,
                Score: d.score,
                User: d.username,
                "Yest Score": d.yestScore !== undefined ? d.yestScore : "N/A",
                "Last Sync": d.lastUpdated ? d.lastUpdated.split("T")[1].split(".")[0] : "???",
            };
        });

        console.table(report);
        console.log("%c ✅ Health Check Complete", "color: #00ff00; font-weight: bold;");
    } catch (err) {
        console.error("❌ Health check failed:", err);
    }
}
// Run it immediately
checkStandingsHealth();
